{
  "name": "pi-customizations",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives extensions_src tests",
    "test": "PI_EXTENSION_KEYBINDINGS_PATH=tests/fixtures/extension-keybindings.json node --test \"tests/**/*.test.ts\"",
    "test:nix-keybindings": "bash tests/keybindings_nix_fixtures.sh",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:nix-keybindings"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.0",
    "@earendil-works/pi-coding-agent": "0.82.0",
    "@earendil-works/pi-tui": "0.82.0",
    "@types/node": "^24.0.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typebox": "^1.0.0",
    "typescript": "7.0.2"
  }
}
