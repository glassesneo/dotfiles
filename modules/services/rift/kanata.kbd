(deffakekeys
  rift-lcmd-arm XX
  rift-rcmd-arm XX
)

(defalias
  rift-lcmd-arm-open (hold-for-duration 300 rift-lcmd-arm)
  rift-rcmd-arm-open (hold-for-duration 300 rift-rcmd-arm)
  rift-next (one-shot-release-pcancel 500 (layer-while-held rift))

  rift-lmet (switch
    ((input virtual rift-lcmd-arm)) @rift-next break
    () (multi lmet @rift-lcmd-arm-open) break
  )

  rift-rmet (switch
    ((input virtual rift-rcmd-arm)) @rift-next break
    () (multi rmet @rift-rcmd-arm-open) break
  )

  ;; Swallow plain Command-H while preserving Command chords that add another
  ;; modifier and the separate double-Command Rift navigation flow.
  cmd-h-guard (switch
    ((and
       (or (input real lmet) (input real rmet))
       (not (or (input real lctl) (input real rctl) (input real lalt) (input real ralt) (input real lsft) (input real rsft)))
     ))
      XX
      break
    ()
      h
      break
  )

  ;; Private Kanata -> Rift protocol. F14-F17 encode left/down/up/right;
  ;; modifiers distinguish focus, move, and join. F18-F20 encode commands.
  rift-focus-left  C-M-f14
  rift-focus-down  C-M-f15
  rift-focus-up    C-M-f16
  rift-focus-right C-M-f17

  rift-move-left  C-S-M-f14
  rift-move-down  C-S-M-f15
  rift-move-up    C-S-M-f16
  rift-move-right C-S-M-f17

  rift-join-left  C-A-M-f14
  rift-join-down  C-A-M-f15
  rift-join-up    C-A-M-f16
  rift-join-right C-A-M-f17
  rift-toggle-fullscreen-within-gaps C-A-S-M-f18
  rift-center-selection C-A-S-M-f19
  rift-toggle-stack C-A-S-M-f20

  rift-join-hold (layer-while-held rift-join)

  rift-left (switch
    ((or (input real lsft) (input real rsft))) @rift-move-left break
    () @rift-focus-left break
  )
  rift-down (switch
    ((or (input real lsft) (input real rsft))) @rift-move-down break
    () @rift-focus-down break
  )
  rift-up (switch
    ((or (input real lsft) (input real rsft))) @rift-move-up break
    () @rift-focus-up break
  )
  rift-right (switch
    ((or (input real lsft) (input real rsft))) @rift-move-right break
    () @rift-focus-right break
  )
)

;; Startup-selected sparse overlay for Rift. All unspecified keys transparently
;; fall back to the canonical first-defined layer in the selected Kanata profile.
(deflayermap (rift-base)
  c c
  h @cmd-h-guard
  , ,
  lmet @rift-rmet
  rmet @rift-lmet
  _ _
)

(deflayer rift
  _ _ _ _ _ _ _ _
  @rift-join-hold _ @rift-toggle-fullscreen-within-gaps @rift-center-selection _ _ _ @rift-left
  XX @rift-down @rift-up @rift-right @rift-toggle-stack XX
  _
  @rift-lmet
  @rift-rmet
  _
)

(deflayer rift-join
  _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ @rift-join-left
  XX @rift-join-down @rift-join-up @rift-join-right @rift-toggle-stack XX
  _
  ;; rift-join sits above rift-base, but transparent keys resolve to the
  ;; canonical first layer under delegate-to-first-layer, so keep meta keys explicit.
  @rift-lmet
  @rift-rmet
  _
)
