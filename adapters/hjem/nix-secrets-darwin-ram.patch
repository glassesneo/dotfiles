+fn verified_ram_mount(mountpoint: &Path) -> Result<bool> {
+    use std::process::{Command, Stdio};
+
+    let physical = fs::canonicalize(mountpoint)?;
+    let path = physical.to_str().ok_or_eyre("Invalid mount path")?;
+    if path.contains('\n') {
+        return Err(eyre!("Invalid mount path"));
+    }
+    let mounts = Command::new("/sbin/mount").output()?;
+    if !mounts.status.success() {
+        return Err(eyre!("Failed to inspect mounted filesystems"));
+    }
+    let mount_text = String::from_utf8(mounts.stdout)?;
+    let suffix = format!(" on {path} (");
+    let devices: Vec<&str> = mount_text.lines()
+        .filter_map(|line| line.split_once(&suffix).map(|(device, _)| device))
+        .collect();
+    if devices.is_empty() {
+        if fs::read_dir(&physical)?.next().is_some() {
+            return Err(eyre!("Refusing nonempty directory without a verified RAM mount"));
+        }
+        return Ok(false);
+    }
+    if devices.len() != 1 {
+        return Err(eyre!("Ambiguous secret mount"));
+    }
+    let mut info = Command::new("/usr/bin/hdiutil").args(["info", "-plist"])
+        .stdout(Stdio::piped()).stderr(Stdio::null()).spawn()?;
+    let converted = Command::new("/usr/bin/plutil")
+        .args(["-convert", "json", "-o", "-", "--", "-"])
+        .stdin(info.stdout.take().ok_or_eyre("Missing disk image output")?).output()?;
+    let status = info.wait()?;
+    if !status.success() || !converted.status.success() {
+        return Err(eyre!("Failed to inspect disk images"));
+    }
+    let images: serde_json::Value = serde_json::from_slice(&converted.stdout)?;
+    let images = images.get("images").and_then(serde_json::Value::as_array)
+        .ok_or_eyre("Missing disk image list")?;
+    let verified = images.iter().any(|image| {
+        image.get("image-path").and_then(serde_json::Value::as_str)
+            .is_some_and(|source| source.starts_with("ram://"))
+        && image.get("system-entities").and_then(serde_json::Value::as_array)
+            .is_some_and(|entities| entities.iter().any(|entity| {
+                entity.get("mount-point").and_then(serde_json::Value::as_str) == Some(path)
+                && entity.get("dev-entry").and_then(serde_json::Value::as_str) == devices.first().copied()
+            }))
+    });
+    if !verified {
+        return Err(eyre!("Refusing filesystem without verified RAM backing"));
+    }
+    Ok(true)
+}
